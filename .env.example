# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-me-for-local-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL (used by Docker Compose)
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://portfolio:replace-me@db:5432/portfolio

# Next.js
# Server-side requests from the frontend container use the Compose service name.
API_INTERNAL_URL=http://backend:8000/api/v1
# Public browser-side API URL. Keep this non-secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
